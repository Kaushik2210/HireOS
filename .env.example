# HireOS environment. Copy to .env.local and fill in. All values optional in demo mode.

# Supabase (database, auth, storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI backend: HireOS calls an LLM through its LLMProvider interface (default: Anthropic API)
ANTHROPIC_API_KEY=

# Background jobs (Inngest)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Email provider for approved drafts (Resend)
RESEND_API_KEY=

# Job providers (add keys here as providers are introduced)
